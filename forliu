#!/bin/bash
# FORLIU CLI Launcher
# 用法: forliu <command> [options]

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# cd 到 FORLIU 根目录，让 python -m code.main 能找到模块
cd "$SCRIPT_DIR"

# 优先 python3，兼容 Windows 的 python
if command -v python3 >/dev/null 2>&1; then
    exec python3 -m code.main "$@"
elif command -v python >/dev/null 2>&1; then
    exec python -m code.main "$@"
else
    echo "错误：未找到 python3 或 python，请先安装 Python 3.9+" >&2
    exit 1
fi
